 /// Two figures agree within 0.5% relative error (formatting-independent).
+/// Does `t` state a figure equal in value to `v`, within rel_close's tolerance?
+///
+/// The numeric miss and wrong penalties below used a token-hash test, which asks whether the
+/// exact same characters appear. That reads "50000" and "50000.0" as different numbers, so an
+/// answer stating a figure correctly in a different format was scored as stating a WRONG one and
+/// took the M_NUM_WRONG multiplier. Same figure, same value, penalised for its spelling.
+///
+/// The value comparison already existed for the numeric bonus (see rel_close). It just was not
+/// wired into the penalties. This is that wiring: the hash test still counts a hit, and a value
+/// match now counts as one too.
+fn has_value(t: &Toks, v: f32) -> bool {
+    let mut i = 0;
+    while i < t.n {
+        if t.val[i] > 0.0 && rel_close(t.val[i], v) { return true; }
+        i += 1;
+    }
+    false
+}
+
 fn rel_close(a: f32, b: f32) -> bool {
     let d = if a > b { a - b } else { b - a };
     let aa = if a < 0.0 { -a } else { a };
